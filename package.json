{
  "name": "ferryjoy-client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.2.15",
  "scripts": {
    "start": "bun x expo start",
    "web": "clear && expo start -c --web",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "clean": "rm -rf .expo node_modules",
    "postinstall": "bun x tailwindcss -i ./src/global.css -o ./node_modules/.cache/nativewind/global.css",
    "prepare": "bun run postinstall",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write --unsafe src/",
    "organize-imports": "biome check --write --unsafe src/",
    "typecheck": "tsc --noEmit",
    "check:all": "bun run lint && bun run format && bun run typecheck",
    "fix:all": "bun run check:fix && bun run organize-imports",
    "reset": "bun run clean && bun install",
    "optimize-routes": "node scripts/optimize-routes.js",
    "convex:dev": "bun x convex dev",
    "convex:deploy": "bun x convex deploy",
    "convex:deploy:prod": "bun x convex deploy --prod",
    "convex:codegen": "bun x convex codegen",
    "convex:typecheck": "bun x convex typecheck",
    "convex:run": "bun x convex run",
    "convex:run:prod": "bun x convex run --prod",
    "convex:logs": "bun x convex logs",
    "convex:logs:prod": "bun x convex logs --prod",
    "convex:dashboard": "bun x convex dashboard",
    "convex:auth": "bun x convex auth",
    "convex:init": "bun x convex init",
    "convex:dev:all": "bun run convex:dev & bun run start"
  },
  "dependencies": {
    "@convex-dev/crons": "^0.1.9",
    "@gorhom/bottom-sheet": "^5.2.4",
    "@math.gl/web-mercator": "^4.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/hooks": "^100.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@react-navigation/stack": "^7.4.8",
    "@rn-primitives/avatar": "~1.2.0",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@rn-primitives/portal": "~1.3.0",
    "@rn-primitives/progress": "~1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/tooltip": "~1.2.0",
    "@rnmapbox/maps": "^10.1.41",
    "@tanstack/query-persist-client-core": "^5.85.6",
    "@tanstack/query-sync-storage-persister": "^5.85.6",
    "@tanstack/react-query": "^5.85.6",
    "@turf/turf": "^7.2.0",
    "@types/bun": "^1.2.21",
    "@types/three": "^0.178.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.26.2",
    "expo": "^54.0.0-canary-20250830-81bb199",
    "expo-blur": "15.0.5-canary-20250830-81bb199",
    "expo-constants": "18.0.6-canary-20250830-81bb199",
    "expo-linking": "8.0.6-canary-20250830-81bb199",
    "expo-location": "19.0.5-canary-20250830-81bb199",
    "expo-navigation-bar": "5.0.6-canary-20250830-81bb199",
    "expo-router": "6.0.0-canary-20250830-81bb199",
    "expo-splash-screen": "31.0.7-canary-20250830-81bb199",
    "expo-status-bar": "3.0.6-canary-20250830-81bb199",
    "expo-system-ui": "6.0.5-canary-20250830-81bb199",
    "expo-web-browser": "15.0.5-canary-20250830-81bb199",
    "lucide-react-native": "^0.511.0",
    "mapbox-gl": "^3.14.0",
    "ml-regression": "^6.3.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-map-gl": "^8.0.4",
    "react-native": "0.81.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-logs": "^5.3.0",
    "react-native-reanimated": "~4.0.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.15.4",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.4.2",
    "tailwind-merge": "^2.6.0",
    "viewport-mercator-project": "^7.0.4",
    "ws-dottie": "^0.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@biomejs/biome": "^2.2.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "~19.0.14",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "expo-dev-client": "~5.2.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "3.3.5",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=18 <23"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
